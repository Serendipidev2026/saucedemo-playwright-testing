{
	"compilerOptions": {
		"target": "ESNext",
		"module": "commonjs",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@pages/*": ["pages/*"]
		},
		"outDir": "dist",
		"rootDir": ".",
		"types": ["node", "@playwright/test"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
